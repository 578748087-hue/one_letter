<view class="screen">
  <view class="screen-header" style="padding-top:{{topOffset}}px">
    <text class="header-title">我的</text>
    <view class="header-spacer" />
  </view>

  <view class="profile-body">
    <view class="profile-quick-grid">
      <view class="quick-tile glass-card" hover-class="hover-scale" hover-stay-time="80" data-filter="sent" bindtap="openMailbox">
        <view class="tile-icon-circle"><icon-svg name="envelope" size="18" color="#c9956c" /></view>
        <text class="tile-label">已写信件</text>
        <text class="tile-count">{{counts.mailbox}}</text>
      </view>
      <view class="quick-tile glass-card" hover-class="hover-scale" hover-stay-time="80" data-filter="deleted" bindtap="openMailbox">
        <view class="tile-icon-circle"><icon-svg name="trash" size="18" color="#c9956c" /></view>
        <text class="tile-label">已删除信件</text>
        <text class="tile-count">{{counts.deleted}}</text>
      </view>
      <view class="quick-tile glass-card" hover-class="hover-scale" hover-stay-time="80" data-filter="favorited" bindtap="openMailbox">
        <view class="tile-icon-circle"><icon-svg name="star" size="18" color="#c9956c" /></view>
        <text class="tile-label">收藏信件</text>
        <text class="tile-count">{{counts.favorites}}</text>
      </view>
    </view>

    <text class="profile-footer">写信 {{version}} · 用心记录每一封信</text>
  </view>
</view>
