<view class="page library safe-bottom">
  <view class="filters"><view class="filter {{category === item.id ? 'active' : ''}}" wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" bindtap="filter">{{item.name}}</view></view>
  <view class="grid"><view class="item" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="choose"><image src="{{item.image}}" mode="aspectFill" /><text>{{item.name}}</text></view></view>
</view>
