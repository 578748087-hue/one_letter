<view class="page home safe-bottom">
  <image class="home-bg" src="/assets/home-bg.png" mode="aspectFill" />
  <view class="content">
    <text class="greeting">{{greeting}}</text>
    <image class="headline" src="/assets/home-headline.png" mode="widthFix" />

    <button class="start-card glass" bindtap="compose">
      <view class="quill">✎</view>
      <view class="start-copy"><text class="start-title">开始写信</text><text>记录此刻的思绪</text></view>
      <text class="chevron">›</text>
    </button>

    <view class="quick-grid">
      <button class="quick glass" data-filter="draft" bindtap="openMailbox"><text class="quick-icon">⌑</text><text>草稿箱</text><text class="count">{{counts.drafts}}</text></button>
      <button class="quick glass" data-filter="sent" bindtap="openMailbox"><text class="quick-icon">✉</text><text>已寄出</text><text class="count">{{counts.sent}}</text></button>
      <button class="quick glass" data-filter="favorite" bindtap="openMailbox"><text class="quick-icon">☆</text><text>收藏</text><text class="count">{{counts.favorites}}</text></button>
    </view>

    <view class="section-head"><text class="section-title">信纸库</text><text class="more" bindtap="openStationery">查看全部 ›</text></view>
    <view class="papers">
      <view class="paper" wx:for="{{stationery}}" wx:key="id" data-id="{{item.id}}" bindtap="chooseStationery">
        <image src="{{item.image}}" mode="aspectFill" />
      </view>
    </view>

    <view class="section-head"><text class="section-title">写信灵感</text></view>
    <scroll-view class="inspiration-scroll" scroll-x enhanced show-scrollbar="false">
      <view class="inspiration-row">
        <view class="inspiration inspiration-{{index}}" wx:for="{{inspirations}}" wx:key="id" data-id="{{item.id}}" bindtap="useTemplate">
          <text class="inspiration-title">{{item.name}}</text><text class="inspiration-copy">落笔，让心意慢慢抵达</text><text class="arrow">›</text>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
